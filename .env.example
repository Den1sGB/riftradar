# ==============================================================================
# RiftRadar Environment Configuration (Copy to .env and replace all values)
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=riftradar
POSTGRES_USER=riftradar
POSTGRES_PASSWORD=change-me-strong-postgres-password
DB_URL=jdbc:postgresql://localhost:5432/riftradar
DB_USERNAME=riftradar
DB_PASSWORD=change-me-strong-postgres-password

# Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password

# Security / JWT (Minimum 32+ random characters for HMAC-SHA256)
JWT_SECRET=change-me-to-a-64-char-cryptographically-random-secret-key-0123456789
JWT_ISSUER=riftradar
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Riot Games API
# Mode: "mock" for deterministic local/CI data, "http" for live Riot Games API
RIOT_GATEWAY_MODE=mock
RIOT_API_KEY=RGAPI-replace-with-your-dev-or-prod-key
RIOT_DEFAULT_PLATFORM=BR1
RIOT_DEFAULT_ROUTING=AMERICAS

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
